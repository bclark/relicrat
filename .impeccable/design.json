      "html": "<div class=\"ds-sample\"><label class=\"ds-label\" for=\"ds-title\">Title</label><input class=\"ds-input\" id=\"ds-title\" placeholder=\"e.g. Comic with a blue cover\"></div>",
      "css": ".ds-sample{font-family:var(--font,system-ui);font-size:16px;line-height:1.5;color:var(--ink,#302B28)}.ds-label{display:block;font-size:.9rem;font-weight:650;margin:0 0 7px}.ds-input{font:inherit;width:100%;min-width:0;min-height:44px;color:var(--ink,#302B28);background:var(--paper,#FFFFFF);border:1px solid var(--muted,#595650);border-radius:var(--radius,6px);padding:var(--control-pad,10px) 12px;caret-color:var(--accent,#823B3D)}.ds-input::placeholder{color:var(--muted,#595650);opacity:1}.ds-input:focus-visible{outline:3px solid var(--focus,#823B3D);outline-offset:3px}",
      "refersTo": "input"
    },
    {
      "name": "Intake panel",
      "kind": "card",
      "description": "Left-side desktop intake; mobile Show/Hide disclosure preserves the unsaved entry draft.",
      "html": "<div class=\"ds-sample\"><section class=\"ds-intake\"><h2 id=\"ds-add-find\" tabindex=\"-1\"><span class=\"ds-intake-title\">Add a find</span><button class=\"ds-intake-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"ds-intake-fields\">Add a find<span aria-hidden=\"true\">Show</span></button></h2><div id=\"ds-intake-fields\" class=\"ds-intake-fields\" data-open=\"false\"><p>Start with a title. Everything else is optional.</p></div></section></div>",
      "css": ".ds-sample{font-family:var(--font,system-ui);font-size:16px;line-height:1.5;color:var(--ink,#302B28)}.ds-intake{background:var(--paper,#FFFFFF);padding:calc(var(--space,32px) - 4px);border:1px solid var(--rule,#C6C9C3);border-radius:var(--panel-radius,12px)}.ds-intake h2{font-family:var(--heading-font,system-ui);font-size:1.5rem;font-weight:700;letter-spacing:-.025em;line-height:1.2;margin:0 0 10px;scroll-margin-top:24px}.ds-intake h2:focus-visible{outline:3px solid var(--focus,#823B3D);outline-offset:3px}.ds-intake p{color:var(--muted,#595650);margin:0 0 22px;max-width:65ch}@media(max-width:850px){.ds-intake{padding:24px 20px}}.ds-intake-toggle{display:none;width:100%;min-height:44px;align-items:center;justify-content:space-between;text-align:left;font:inherit;font-weight:700;padding:0;background:transparent;border:0;color:inherit;cursor:pointer}.ds-intake-toggle span{font-size:.875rem;font-weight:500;color:var(--muted,#595650)}.ds-intake-toggle:focus-visible{outline:3px solid var(--focus,#823B3D);outline-offset:3px}@media(max-width:650px){.ds-intake-title{display:none}.ds-intake-toggle{display:flex}.ds-intake h2{margin-bottom:0}.ds-intake-fields{display:none}.ds-intake-fields[data-open=true]{display:block;padding-top:16px}}",
      "refersTo": "intake-panel"
    },
    {
      "name": "Selected collection row",
      "kind": "button",
      "description": "One selected physical copy, identified with aria-pressed.",
      "html": "<div class=\"ds-sample\"><button class=\"ds-row\" aria-pressed=\"true\"><strong>Synthetic blue-cover comic</strong><span>A provisional copy for the first trial.</span><small class=\"ds-copy-summary\"><span>Saved copy</span><span>No location yet</span></small></button></div>",
      "css": ".ds-sample{font-family:var(--font,system-ui);font-size:16px;line-height:1.5;color:var(--ink,#302B28)}.ds-row{font:inherit;width:100%;min-height:44px;border:0;border-radius:0;text-align:left;padding:var(--row-pad,18px) 12px;display:block;color:var(--ink,#302B28);background:var(--soft,#E8EEE9);box-shadow:inset 0 0 0 1px var(--accent,#823B3D);cursor:pointer}.ds-row strong,.ds-row span,.ds-row small{display:block;overflow-wrap:anywhere}.ds-row strong{font-weight:650;font-size:1.125rem;line-height:1.4}.ds-row span{font-size:.875rem;color:var(--muted,#595650);font-weight:400;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:5px}.ds-row small{font-size:.75rem;color:var(--muted,#595650);font-weight:500;margin-top:9px}.ds-row:hover{background:var(--soft,#E8EEE9)}.ds-row:active{background:var(--soft,#E8EEE9)}.ds-row:focus-visible{outline:3px solid var(--focus,#823B3D);outline-offset:3px}.ds-row .ds-copy-summary{display:flex;flex-wrap:wrap;gap:4px 20px;margin-top:12px}.ds-row .ds-copy-summary span{display:block;margin:0;font-size:.75rem;font-weight:500}",
