  "narrative": {
    "northStar": "The new-arrivals workbench",
    "overview": "This is a descriptive record of the current inventory implementation, extracted from apps/web/app/globals.css and its React components. The new-arrivals workbench uses white paper, cool blue-gray support, restrained navy ink and cobalt actions to make provisional physical copies easy to record and find. The surface operates as a working register, with plain labeled controls and text-led records.\n\nThe owner chose an add-first screen and a direct working-interface build for this task. This record does not infer a permanent brand, palette preference or global build-path preference. The separate frozen progress report through PR #14 retains its own [historical design record](docs/design/project-dashboard.md) and [preserved sidecar](.impeccable/project-dashboard-design.json); it is not current application guidance.",
    "keyCharacteristics": [
      "System UI sans for an Operate workflow.",
      "Flat paper and ruled rows with one explicit selection.",
      "Visible save, loading, conflict and recovery states.",
      "Responsive reading order and keyboard focus."
    ],
    "rules": [
      {
        "name": "The Explicit State Rule",
        "body": "Pair state colors with readable text and programmatic status; color alone does not establish a saved record.",
        "section": "colors"
      },
      {
        "name": "The Separate Save Rule",
        "body": "Make confirmed copy, photo and location saves distinguishable; selecting a location does not move the copy.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve visible labels, focus outlines and textual status alongside color.",
      "**Do** use contained photos of the physical copy as user data.",
      "**Do** preserve separate save actions and explicit review after uncertain writes."
    ],
    "donts": [
      "**Don't** turn the historical progress report into app design guidance.",
      "**Don't** imply saved data, identity or production readiness through visual state alone.",
      "**Don't** treat this implementation record as a permanent user brand preference."
    ]
  }
}
