{
  "album": {
    "schema_version": 1,
    "id": "record",
    "label": "Album",
    "plural_label": "Albums",
    "title": {
      "key": "title",
      "label": "Album title",
      "max_length": 500,
      "placeholder": "e.g. Album title",
      "suggested": true
    },
    "fields": [
      {
        "key": "artist",
        "label": "Artist or band",
        "max_length": 500,
        "placeholder": "",
        "suggested": true,
        "input": "autocomplete"
      },
      {
        "key": "format",
        "label": "Format",
        "max_length": 100,
        "placeholder": "e.g. Vinyl, CD or cassette",
        "suggested": true,
        "input": "select",
        "options": [
          "Vinyl",
          "CD",
          "Cassette"
        ]
      },
      {
        "key": "edition",
        "label": "Edition or pressing",
        "max_length": 500,
        "placeholder": "",
        "suggested": true
      },
      {
        "key": "notes",
        "label": "Notes",
        "max_length": 10000,
        "placeholder": "Distinctive details, condition, or where you found it",
        "suggested": true
      }
    ],
    "entry_order": [
      "artist",
      "title",
      "format",
      "edition",
      "notes"
    ],
    "grouping": {
      "field": "artist",
      "plural_label": "Artists",
      "unknown_label": "Artist not recorded",
      "order": "title"
    },
    "barcode_formats": [
      "UPC_A",
      "UPC_E",
      "EAN_8",
      "EAN_13"
    ],
    "lookup": {
      "provider": "musicbrainz",
      "action_label": "Find album details",
      "max_results": 5,
      "field_mappings": {
        "title": "title",
        "artist": "artist",
        "format": "format"
      },
      "value_maps": {
        "format": {
          "7\" Vinyl": "Vinyl",
          "10\" Vinyl": "Vinyl",
          "12\" Vinyl": "Vinyl"
        }
      },
      "cover_art": true
    }
  },
